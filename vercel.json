{
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "framework": "vite",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "github": {
    "silent": true
  }
}